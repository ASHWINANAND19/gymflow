{
  "name": "gymflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file=.env.local scripts/setup-db.js",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "db:reset": "npm run db:setup && npm run db:seed",
    "test": "node --env-file=.env.local --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "mongodb": "^6.21.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4"
  },
  "type": "module"
}
